# Neon: DATABASE_URL is the POOLED endpoint (host contains "-pooler") used for
# queries; DIRECT_URL is the direct endpoint, which Prisma needs for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
APP_PASSWORD="change-me"
APP_SESSION_TOKEN="generate-a-long-random-string"

# ── Skiles Group Connect integration (registered tool slug: schedule-manager) ──
# Every one of these fails SILENTLY at launch if unset or wrong. Leave them all
# unset to run standalone; set them all to run inside Connect.

# OS backend base for Tool Gateway calls. MUST end in /api and point at the OS
# backend, never the frontend — lib/os-gateway.ts appends /tool-gateway/...
#   Local:      http://localhost:4000/api
#   Production: https://api.sgconnect.dev/api
SKILES_OS_API_BASE_URL=""

# Allowed OS origins for the launch returnUrl (open-redirect guard).
# COMMA-SEPARATED — production serves www while the apex redirects to it, and the
# OS builds returnUrl from window.location.origin, so both must be listed or every
# launch 400s. Add OS preview origins here too when testing against them.
#   Local:      http://localhost:5173
#   Production: https://www.sgconnect.dev,https://sgconnect.dev
SKILES_OS_APP_ORIGIN=""

# Mounts the app under its sub-path so assets resolve behind the OS rewrite and
# the session cookie is path-scoped. Must match the OS manifest launch path.
BASE_PATH="/schedule-manager"

# This tool's public base for redirects — MUST include BASE_PATH.
#   Production: https://sgconnect.dev/schedule-manager
APP_BASE_URL=""
