# Neon: DATABASE_URL is the POOLED endpoint (host contains "-pooler") used for
# queries; DIRECT_URL is the direct endpoint, which Prisma needs for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require"
APP_PASSWORD="change-me"

# HMAC key for the session and scope cookies. SERVER-ONLY — it is never sent to a
# client in any form. Replaces APP_SESSION_TOKEN, which was both the signing key
# AND the literal session-cookie value: leaking a session cookie leaked the key
# that forges arbitrary scope cookies. Must be at least 32 characters; the app
# refuses to sign or verify anything with a shorter one. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SIGNING_SECRET="generate-a-long-random-string"

# Elevated (admin) access: marking scopes coarse, unmapping standard names,
# resetting a project's schedule data. Two independent ways in — set either,
# both, or neither.
#
# 1. Standalone: log in with this password instead of APP_PASSWORD.
APP_ADMIN_PASSWORD=""
# 2. Launched from Connect, where no password is ever typed: the OS hands down
#    access.toolLevel in the launch handoff, already resolved from this
#    person's project access and org-wide role. toolLevel === "admin" is
#    admin here; there is no env config for this — it is not a per-tool
#    allowlist choice.

# ── Skiles Group Connect integration (registered tool slug: schedule-manager) ──
# Every one of these fails SILENTLY at launch if unset or wrong. Leave them all
# unset to run standalone; set them all to run inside Connect.

# OS backend base for Tool Gateway calls. MUST end in /api and point at the OS
# backend, never the frontend — lib/os-gateway.ts appends /tool-gateway/...
#   Local:      http://localhost:4000/api
#   Production: https://api.sgconnect.dev/api
SKILES_OS_API_BASE_URL=""

# Allowed OS origins for the launch returnUrl (open-redirect guard).
# COMMA-SEPARATED — production serves www while the apex redirects to it, and the
# OS builds returnUrl from window.location.origin, so both must be listed or every
# launch 400s. Add OS preview origins here too when testing against them.
#   Local:      http://localhost:5173
#   Production: https://www.sgconnect.dev,https://sgconnect.dev
SKILES_OS_APP_ORIGIN=""

# Mounts the app under its sub-path so assets resolve behind the OS rewrite and
# the session cookie is path-scoped. Must match the OS manifest launch path.
BASE_PATH="/schedule-manager"

# This tool's public base for redirects — MUST include BASE_PATH.
#   Production: https://sgconnect.dev/schedule-manager
APP_BASE_URL=""

# Verifies X-OS-Callback-Signature on inbound OS context callbacks
# (POST /api/os-context, the manifest's launch.contextEndpoint). The OS signs
# with the SAME value, set on its Render service under this exact name — the
# name is derived from the registry slug, so it is not free to differ.
# Unset, or different from the OS's copy, and every callback 401s: the tool
# asking for our schedule sees a 503 it cannot diagnose from its own side.
SCHEDULE_MANAGER_CONTEXT_SECRET=""
